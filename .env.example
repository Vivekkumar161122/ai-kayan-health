# Al-Kayan Health - Environment Configuration Template
# Copy this file to .env.local for local overrides

# Application Base Path (default is '/' for root domain deployment like Vercel/Netlify)
# If deploying to a subdirectory (e.g. GitHub Pages https://<user>.github.io/<repo>/), set to /<repo>/
VITE_BASE_PATH=/

# Local Dev Server Port (default: 3000)
PORT=3000
